    {
      "value": "\"goals\" >= 0 AND \"assists\" >= 0 AND \"mvp\" IN (0, 1)",
      "name": "valid_player_stats",
      "entityType": "checks",
      "schema": "public",
      "table": "match_stats"
    },
    {
      "value": "\"home_id\" <> \"away_id\"",
      "name": "different_teams",
      "entityType": "checks",
      "schema": "public",
      "table": "matches"
    },
    {
      "value": "(\"home_score\" IS NULL AND \"away_score\" IS NULL) OR (\"home_score\" IS NOT NULL AND \"away_score\" IS NOT NULL AND \"home_score\" >= 0 AND \"away_score\" >= 0 AND \"home_score\" <= 99 AND \"away_score\" <= 99)",
      "name": "valid_match_scores",
      "entityType": "checks",
      "schema": "public",
      "table": "matches"
    },
    {
      "value": "(\"home_penalty_score\" IS NULL AND \"away_penalty_score\" IS NULL) OR (\"home_penalty_score\" IS NOT NULL AND \"away_penalty_score\" IS NOT NULL AND \"home_penalty_score\" >= 0 AND \"away_penalty_score\" >= 0 AND \"home_penalty_score\" <= 99 AND \"away_penalty_score\" <= 99 AND \"home_penalty_score\" <> \"away_penalty_score\" AND \"home_score\" IS NOT NULL AND \"away_score\" IS NOT NULL AND \"competition\" IN ('champions', 'europa', 'copa', 'supercopa_liga', 'supercopa_europa') AND \"round\" LIKE '% \u00b7 Vuelta')",
      "name": "valid_penalty_scores",
      "entityType": "checks",
      "schema": "public",
      "table": "matches"
    },
